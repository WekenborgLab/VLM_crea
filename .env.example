# Copy to .env and fill in. .env is gitignored — never commit it.

# --- REQUIRED ---
# Folder containing one subfolder per participant/group, each holding JPG/PNG images.
FOLDERPATH=/path/to/images
# OpenAI-compatible endpoint (e.g. a local vLLM/SGLang server, or https://api.openai.com/v1)
BASE_URL=http://localhost:8000/v1
MODEL=Qwen3.5-397B-A17B-FP8
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OUTPUTS ---
# A timestamped run folder is created inside this directory.
OUTPUT_DIR=./results

# --- GENERATION CONTROLS (only sent to the API if set) ---
SEED=42
# TEMPERATURE=0.0
# MAX_COMPLETION_TOKENS=500
# Suppresses reasoning traces on models that support it (Qwen3.x chat template).
DISABLE_THINKING=true

# --- CATEGORIES (first match wins) ---
# Option A: comma-separated list. This is what run_experiment.sh exports.
# CATEGORIES=SocialDensity,NatureScore,InsideOutside,Animals,FoodDrinks,Greenness,DigitalGadget,GadgetsMedia,PlantPresence,NaturalLightExposure,Smartphone,PC,Laptop,TV,Flatscreen,Smartwatch,Tablet,Monitor,Display,Camera,ElectronicWearableDevice,eBookReader,Screen,Temperature
# Option B: single category
# CATEGORY=PlantPresence
# Option C: read from an Excel/CSV column (defaults to the first column)
# CATEGORIES_EXCEL_PATH=/path/to/categories.xlsx
# CATEGORIES_COLUMN_LABEL=Categories
# If none are set, falls back to: NatureScore, PlantPresence, NaturalLightExposure, Greenness, InsideOutside

# --- THROUGHPUT / MEMORY ---
MAX_CONCURRENCY=5              # images processed in parallel
PER_IMAGE_JOBS_CONCURRENCY=20  # categories requested in parallel per image

# Longest-side cap in pixels before JPEG re-encoding (0 = no resize)
MAX_IMAGE_SIZE=1024
JPEG_QUALITY=85

CONVERT_TO_EXCEL=True
PROGRESS_REFRESH_INTERVAL=0.5
DELETE_ORIGINALS=False

# --- ERROR HANDLING / RESUME ---
FAIL_FAST=True
# Skip (category, image) pairs already present in the CSVs of RESUME_DIR.
# RESUME=True
# RESUME_DIR=./results/20260304072426

# --- RUN METADATA (experiment.json / experiment_summary.csv) ---
WRITE_EXPERIMENT_METADATA=True
# EXPERIMENT_NAME=repeat_1
# EXPERIMENT_NOTES=free-text description

# --- OPTIONAL: COST ESTIMATION (USD per 1K tokens) ---
# PROMPT_COST_PER_1K=2.50
# COMPLETION_COST_PER_1K=10.00
